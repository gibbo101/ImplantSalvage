<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>Luke_ExtractImplant</defName>
    <driverClass>ImplantSalvage.JobDriver_ExtractImplant</driverClass>
    <reportString>extracting implant from TargetA.</reportString>

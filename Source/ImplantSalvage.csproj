<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <AssemblyName>ImplantSalvage</AssemblyName>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Slice 1 needs NO Harmony: FloatMenuMakerMap discovers FloatMenuOptionProvider
         subclasses via AllSubclassesNonAbstract(), so our provider auto-registers.
         It also needs no MultiplayerAPI: Multiplayer already syncs
         Pawn_JobTracker.TryTakeOrderedJob, which is the only game-state call we make
         from UI code. Add either only if slice 2 requires it. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
  </ItemGroup>

  <!-- Use Krafs.Rimworld.Ref's reference assemblies instead of the .NET Framework dev pack. -->
  <Target Name="RemoveFramework" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
    <PropertyGroup>
      <TargetFrameworkDirectory></TargetFrameworkDirectory>
    </PropertyGroup>
  </Target>

  <!-- Drop the built DLL into the mod's Assemblies/ folder. -->
  <Target Name="CopyToMod" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(ProjectDir)..\Assemblies\" />
  </Target>

</Project>
